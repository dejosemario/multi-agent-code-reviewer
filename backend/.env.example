# --- LLM (OpenRouter) ---
# Required. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Required. Any model id OpenRouter serves, e.g. openai/gpt-4o-mini, anthropic/claude-3.5-sonnet
MODEL_NAME=nvidia/nemotron-3.5-lightning:free
# Optional override, defaults to OpenRouter's standard endpoint.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- GitHub integration (optional, enables PR fetch + posting comments) ---
GITHUB_TOKEN=

# --- Storage ---
# Where the SQLite review-history database lives.
DATABASE_URL=sqlite:///./data/reviews.db
# Where repos get cloned/checked out for inspection during a review.
WORKSPACE_DIR=./workspaces

# --- Server ---
# Frontend dev server origin, for CORS.
CORS_ORIGINS=http://localhost:5173
